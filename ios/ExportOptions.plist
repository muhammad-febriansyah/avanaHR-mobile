<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- App Store Connect / TestFlight distribution. Xcode re-signs with the
	     Distribution profile here, which is what flips aps-environment from
	     development to production. -->
	<key>method</key>
	<string>app-store-connect</string>
	<key>signingStyle</key>
	<string>automatic</string>
	<!-- teamID is intentionally omitted: xcodebuild reads it from the archive's
	     DEVELOPMENT_TEAM. This file does no variable expansion, so a placeholder
	     here would fail the export outright. -->
	<!-- Symbols go up so TestFlight crash reports are symbolicated. -->
	<key>uploadSymbols</key>
	<true/>
	<key>stripSwiftSymbols</key>
	<true/>
	<!-- Upload is a separate, explicit step (Transporter or altool). -->
	<key>destination</key>
	<string>export</string>
</dict>
</plist>
